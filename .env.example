# Copy this file to .env and fill in real values.
# Never commit .env – it is ignored by .gitignore.

# Cloudflare Workers AI – main AI (server-side only, never use a VITE_ prefix!)
# Account ID: dash.cloudflare.com → Workers & Pages; token: My Profile → API Tokens → "Workers AI" template
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_API_TOKEN=your-cloudflare-api-token

# Optional: Google Gemini API key – fallback when Cloudflare fails. Leave empty to switch it off.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional: Gemini model (default: gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Optional, local development only: stored answers instead of Gemini (costs no quota)
# recipe = example recipe, not-food = no food recognized, error = AI error
# MOCK_AI=recipe

# Upstash Redis for rate limiting (optional locally, required on Vercel production)
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token
